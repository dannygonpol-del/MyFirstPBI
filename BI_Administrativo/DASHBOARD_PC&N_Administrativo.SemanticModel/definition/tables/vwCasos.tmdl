		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure CantPromesasClientes01 = ```
			
			
			VAR _CodigoActual =
			    VALUES(AsesoresCasosGestionesPagos[Codigo])
			
			VAR _FechaInicial =
			    MIN(Calendario[Date])    
			
			VAR _FechaFinal =
			    MAX(Calendario[Date])
			
			RETURN    
			
			CALCULATE(
			    DISTINCTCOUNT(vwCasos[IdPromesa]),
			    TREATAS(
			        VALUES(vwCasosGestiones[CodigoCliente]),
			        vwCasos[CodigoCliente]
			    )  ,
			    REMOVEFILTERS(Calendario),
			
			    vwCasos[FechaPromesa] >= _FechaInicial && vwCasos[FechaPromesa] <= _FechaFinal
			
			)
			
			//+ CALCULATE(
			//    [Cant_Contactos],
			//    vwGestiones[GestionId] = "0087"
			//)
			```
		formatString: 0
		displayFolder: Promesas
		lineageTag: daa9c5a0-1692-4df5-aa7d-21938af1763c

