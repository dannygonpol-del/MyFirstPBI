			        FILTER(
			            vwPagos,
			            vwPagos[CodigoCliente] in values(vwCasos[CodigoCliente]
			        )
			    )
			
			
			// IF(ISINSCOPE(vwPagos[codigo]),max(vwPagos[MontoMeta]), CALCULATE(SUM(vwMetas[MontoMetas]), TREATAS(values(vwPagos[Sucursal_id]),vwMetas[Unidad])))
			)
			
			```
		displayFolder: Recuperación
		lineageTag: b19f91ff-4822-47b3-ae08-aabe899eae86

		annotation PBI_FormatHint = {"isGeneralNumber":true}

