table vwCasos
	lineageTag: e54ab9c8-771f-4a5f-9e6a-7314002755f8

	/// Suma total del monto prometido en promesas de pago
	measure Monto_Prometido = ```
			
			
			// sum(vwCasos[MontoPrometido])
			
			CALCULATE(
			    sum(vwCasos[MontoPrometido]),
			    TREATAS(
			        VALUES(vwPagos[Sucursal_id]),
			        vwCasos[Sucursal]
			    )  
			
			    , vwCasos[Devolucion] = FALSE()
			    
			
			)
			
			
			
			
			
			```
		formatString: $#,0.00;($#,0.00);$#,0.00
		displayFolder: Promesas
		lineageTag: 1909d0cc-395c-4f1b-b7c4-55dd9ba67531

		annotation PBI_FormatHint = {"currencyCulture":"es-DO"}

	/// Suma total del monto cumplido en promesas de pago
	measure Monto_Cumplido = sum(vwCasos[MontoCumplido])
		formatString: $#,0.00;($#,0.00);$#,0.00
		displayFolder: Promesas
		lineageTag: 9b90217c-b64a-4410-8690-91760f8be602

		annotation PBI_FormatHint = {"currencyCulture":"es-DO"}

	/// Cantidad total de promesas de pago registradas
	measure CantPromesas = ```
			
			
			VAR _CodigoActual =
			    VALUES(AsesoresCasosGestionesPagos[Codigo])
			
			VAR _FechaInicial =
			    MIN(Calendario[Date])    
			
			VAR _FechaFinal =
			    MAX(Calendario[Date])
			
			RETURN
			
			CALCULATE(
			    DISTINCTCOUNT(vwCasos[IdPromesa]),
			    REMOVEFILTERS(vwCasos),
			    TREATAS(
			        _CodigoActual,
			        vwCasos[Codigo]
			    ),
			    REMOVEFILTERS(Calendario),
			
			    vwCasos[FechaPromesa] >= _FechaInicial && vwCasos[FechaPromesa] <= _FechaFinal
			
			  //   , (vwCasos[FechaPromesa] = _FechaFinal)
			)
			
			```
		formatString: 0
		displayFolder: Promesas
		lineageTag: 454f92b5-65f1-4fcd-974e-92944a9f4143

	/// Porcentaje del monto cumplido sobre el monto prometido
	measure %PromesasCumplidas =
			DIVIDE(
			    SUM(vwCasos[MontoCumplido]),
			    SUM(vwCasos[MontoPrometido]),
			    0
			)
		formatString: 0.00%
		displayFolder: Promesas
		lineageTag: 18940be5-9939-4fe5-95ca-f06d04f18874

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Suma total del monto prometido (alias de Monto_Prometido)
	measure MontoPromesas = sum(vwCasos[MontoPrometido])
		formatString: $#,0.00;($#,0.00);$#,0.00
		displayFolder: Promesas
		lineageTag: 64b1b585-ab0e-4c4f-9586-a321a1c0c694

		annotation PBI_FormatHint = {"currencyCulture":"es-DO"}

	/// Monto cumplido filtrado por el rango de fechas del calendario
	measure MontosCumplidos = ```
			CALCULATE(    SUM(vwCasos[MontoCumplido]),    
			DATESBETWEEN(        'Calendario'[date],        MIN('Calendario'[date]),        MAX('Calendario'[date])    ))
			```
		formatString: $#,0.00;($#,0.00);$#,0.00
		displayFolder: Promesas
		lineageTag: 649ce0f3-a596-4798-b94d-cad3fcb103aa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Cantidad de promesas con estado CUMPLIDA
	measure CantPromesasCumplidas = ```
			
			
			CALCULATE(COUNTROWS(vwCasos), vwCasos[Estado] = "CUMPLIDA")
			
			```
		formatString: #,0
		displayFolder: Promesas
		lineageTag: 2a8364be-109b-4922-bd4f-3e28829a726e

	/// Cantidad de promesas con estado Incumplida
	measure CantPromesasIncumplidas = CALCULATE(COUNTROWS(vwCasos), vwCasos[Estado] = "Incumplida")
		formatString: #,0
		displayFolder: Promesas
		lineageTag: fe0d60a7-16f0-46a3-9d89-08cad71328dc

	/// Cantidad de promesas con estado Pendiente
	measure CantPromesasPendientes = CALCULATE(COUNTROWS(vwCasos), vwCasos[Estado] = "Pendiente")
		formatString: #,0
		displayFolder: Promesas
		lineageTag: cb66ef64-9316-4dfd-b07f-bda78438c6d2

	/// Porcentaje de promesas cumplidas sobre el total de promesas
	measure %EfectividadPromesas = ```
			
			
			       DIVIDE([CantPromesasCumplidas], [CantPromesas], 0)
			
			
			```
		formatString: 0.00%
		displayFolder: Promesas
		lineageTag: 09a267a0-e92c-45a9-b3d1-f40dc5f70881

	/// Suma total del monto en atraso de los casos
	measure MontoAtraso = SUM(vwCasos[MontoAtrasoRD])
