		displayFolder: Promesas
		lineageTag: 26b1ee62-a500-45fd-94cd-28037a97d8f5

	/// Proporción entre la cantidad de pagos y la cantidad de promesas registradas
	measure %PromesasPagos = DIVIDE(vwPagos[CantPagos],[CantPromesas] ,0)
		displayFolder: Promesas
		lineageTag: fe633e06-838d-4b1d-98bc-c0b4423fc40d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Cantidad distinta de casos activos, filtrada por contexto de vwCasosGestiones sin filtro de calendario
	measure CantidadCasos = ```
			
			
			CALCULATE(
			    DISTINCTCOUNT(vwCarteraVigente[Expedientes]),
			
			    TREATAS(
			        VALUES(vwPagos[Sucursal_id]),   
			        vwCarteraVigente[Sucursal_id]
			    ),
			
			        vwCarteraVigente[CodigoCliente] in VALUES(vwCasos[CodigoCliente])
			    
			    ,   (vwCarteraVigente[Devolucion] = FALSE())
			
			    , REMOVEFILTERS(Calendario)
			)
			
			
			```
		formatString: 0
		displayFolder: Cartera
		lineageTag: 0751a7e9-ff64-4a06-bb96-e470f4c56e83

	/// Suma del saldo de deuda de los casos visibles en el contexto actual
	measure Monto_Deuda = ```
			
			
			CALCULATE(
			    SUM(vwDeudas[deuda]),
			    FILTER(
			        ALL(vwDeudas[casoid]),
			         vwDeudas[casoid]
			            IN VALUES(vwCasos[CasoId])            
			    ) 
			
			
			
			
			
			)
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Cartera
		lineageTag: 464e00ff-6d10-4f19-a889-af7178f5fbbb

		annotation PBI_FormatHint = {"currencyCulture":"es-DO"}

