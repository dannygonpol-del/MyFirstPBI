	/// Cantidad de promesas con estado Pendiente para el asesor en contexto
	measure Promesas_Pendientes = ```
			
			
			VAR _CodigoActual =
			    VALUES(AsesoresCasosGestionesPagos[Codigo])
			
			VAR _FechaInicial =
			    MIN(Calendario[Date])    
			
			VAR _FechaFinal =
			    MAX(Calendario[Date])
			
			RETURN
			
			CALCULATE(
			    DISTINCTCOUNT(vwCasos[IdPromesa]),
			    REMOVEFILTERS(vwCasos),
			    TREATAS(
			        _CodigoActual,
			        vwCasos[Codigo]
			    ),
			    vwCasos[Estado] = "Pendiente"
			
			    ,REMOVEFILTERS(Calendario),
			
			    vwCasos[FechaPromesa] >= _FechaInicial && vwCasos[FechaPromesa] <= _FechaFinal
			
			  //   , (vwCasos[FechaPromesa] = _FechaFinal)
			)
			
