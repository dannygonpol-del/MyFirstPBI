table Calendario
	lineageTag: 8148b837-bfa6-434b-b794-984da19c8d1a
	dataCategory: Time

	/// Fecha mínima disponible en el calendario (inicio del rango de datos)
	measure fecha_inicial = min(Calendario[Date])
		formatString: General Date
		displayFolder: Fechas
		lineageTag: 3e4d385f-52fe-48c2-ac8a-7b4213b8c834

	/// Fecha máxima disponible en el calendario (fin del rango de datos)
	measure Fecha_Final = max(Calendario[Date])
		formatString: General Date
		displayFolder: Fechas
		lineageTag: d469cba3-f3a3-4a19-a2a9-e940c6fa2e2a

	measure RangoSemana = ```
			
			VAR Inicio =
			    MIN('Calendario'[InicioSemana])
			VAR Fin =
			    MAX('Calendario'[FinSemana])
			VAR SemanaSeleccionada = 
			    SELECTEDVALUE('Calendario'[AñoSemana])
			RETURN
			    IF(
			        NOT ISBLANK(SemanaSeleccionada),
			        SemanaSeleccionada
			            & ": "
			            & FORMAT(Inicio, "dd/MM/yyyy")
			            & " - "
			            & FORMAT(Fin, "dd/MM/yyyy"),
			        "Seleccione una semana"
			    )
			```
		lineageTag: a611db48-7eca-4f86-a5c6-1691449f34db

