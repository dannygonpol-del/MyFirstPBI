	partition Calendario = calculated
		mode: import
		source = ```
				
				//ADDCOLUMNS (
				//    CALENDAR (DATE(1900,1,1), EOMONTH(TODAY(),0)), --max(vwCasos[FechaPromesa])),
				//    "Año", YEAR([Date]),
				//    "Mes", FORMAT([Date], "MMMM"),
				//    "MesN", MONTH([Date]),
				//    "AñoMes", FORMAT([Date], "YYYY-MM"),
				//    "Weeks", WEEKNUM([date],2),
				//    "AñoSemana", YEAR([date]) & "-" & FORMAT(WEEKNUM([date], 2), "00")
				//)
				
				VAR FechaInicio = DATE(1900,1,1) //DATE(2020, 1, 1)
				VAR FechaFin = EOMONTH(TODAY(),0) //DATE(2030, 12, 31)
				
				RETURN
				ADDCOLUMNS(
				    CALENDAR(FechaInicio, FechaFin),
				
				    /* =========================
				       INFORMACIÓN DE FECHA
				       ========================= */
				
				    "Año",
				        YEAR([Date]),
				
				    "MesNumero",
				        MONTH([Date]),
				
				    "Mes",
				        FORMAT([Date], "MMMM"),
				
				    "MesCorto",
				        FORMAT([Date], "MMM"),
				
				    "AñoMes",
				        FORMAT([Date], "yyyy-MM"),
				
				    "AñoMesNumero",
				        YEAR([Date]) * 100
				            + MONTH([Date]),
				
				    "TrimestreNumero",
				        QUARTER([Date]),
				
				    "Trimestre",
				        "T" & QUARTER([Date]),
				
				
				    /* =========================
				       INFORMACIÓN DE SEMANA
				       ========================= */
				
				    "Semana",
				        WEEKNUM([Date], 2),
				
				    "SemanaTexto",
				        "Semana "
				            & FORMAT(WEEKNUM([Date], 2), "00"),
				
				    "AñoSemana",
				        FORMAT(YEAR([Date]), "0000")
				            & "-W"
				            & FORMAT(WEEKNUM([Date], 2), "00"),
				
				    "AñoSemanaNumero",
				        YEAR([Date]) * 100
				            + WEEKNUM([Date], 2),
				
				    "InicioSemana",
				        [Date]
				            - WEEKDAY([Date], 2)
				            + 1,
				
				    "FinSemana",
				        [Date]
				            - WEEKDAY([Date], 2)
				            + 7,
				
				
				    /* =========================
				       INFORMACIÓN DEL DÍA
				       ========================= */
				
				    "DiaNumero",
				        DAY([Date]),
				
				    "DiaSemanaNumero",
				        WEEKDAY([Date], 2),
				
				    "DiaSemana",
				        FORMAT([Date], "dddd"),
				
				    "DiaSemanaCorto",
				        FORMAT([Date], "ddd"),
				
				
				    /* =========================
				       PERÍODOS
				       ========================= */
				
				    "InicioMes",
				        DATE(
				            YEAR([Date]),
				            MONTH([Date]),
				            1
				        ),
				
				    "FinMes",
				        EOMONTH([Date], 0),
				
				    "InicioAño",
				        DATE(
				            YEAR([Date]),
				            1,
				            1
				        ),
				
				    "FinAño",
				        DATE(
				            YEAR([Date]),
				            12,
				            31
				        ),
				
				
				    /* =========================
				       INDICADORES
				       ========================= */
				
				    "EsHoy",
				        [Date] = TODAY(),
				
				    "EsAyer",
				        [Date] = TODAY() - 1,
				
				    "EsMesActual",
				        YEAR([Date]) = YEAR(TODAY())
				            &&
				        MONTH([Date]) = MONTH(TODAY()),
				
				    "EsAñoActual",
				        YEAR([Date]) = YEAR(TODAY()),
				
				    "EsSemanaActual",
				        YEAR([Date]) = YEAR(TODAY())
				            &&
				        WEEKNUM([Date], 2)
				            = WEEKNUM(TODAY(), 2)
				)
				
				```

	annotation PBI_Id = 6896be3b2d62419b94d431bad204d9c4

