table vwCasosDistribuidos
	lineageTag: da5b5e11-45d6-4736-8fe4-e8125ac610b4

	measure CantCasosPorDistribuir = ```
			
			
			    Var _CantCasos = CALCULATE(
			                                    DISTINCTCOUNT(vwCasosDistribuidos[CasoId]),
			                                     //  CONTAINSSTRING(vwCasosDistribuidos[EstadoCaso], "GESTI"),                                      
			                                       vwCasosDistribuidos[Codigo] IN {"DISTRIBUIR2", "JJMDENZ"}
			                                     )
			
			  RETURN 
			
			    _CantCasos
			
			```
		formatString: 0
		lineageTag: fc656b7e-1d83-4507-8bdb-169439d7b834

	measure CantCasosDistribuidos = ```
			
			 
			    Var _CantCasos = CALCULATE(
			                                DISTINCTCOUNT(vwCasosDistribuidos[CasoId]),
			                                KEEPFILTERS(
			                                   NOT(vwCasosDistribuidos[Codigo] IN {"DISTRIBUIR2", "JJMDENZ"})
			                                )
			                            )
			
			  RETURN 
			
			    _CantCasos
			    
			```
		formatString: 0
		lineageTag: 6e856e9d-27ef-42eb-92de-e28ffd3a2320

