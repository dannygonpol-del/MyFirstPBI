	measure %RecuperacionAplicada = ```
			
			
			VAR _MetaAsesor =
			    CALCULATE(
			        MAX(vwMetasAsesores[MontoMetas]),
			        REMOVEFILTERS(Calendario),
			        FILTER(
			            ALL(vwMetasAsesores),
			            vwMetasAsesores[Codigo]  in VALUES(AsosoresMetasPagos[Codigo])  ///= SELECTEDVALUE(vwPagos[Codigo])
			        )
			    )
			
			VAR _MetaUnidad =
			    CALCULATE(
			        MAX(vwMetas[MontoMetas]),
			        REMOVEFILTERS(Calendario),
			        FILTER(
			            ALL(vwMetas),
			            vwMetas[Unidad] in VALUES(AsosoresMetasPagos[Sucursal_id])  //= SELECTEDVALUE(vwPagos[Sucursal_id])
			        )
			    )
			
			   VAR _TotalGeneral = DIVIDE([MontosAplicados], vwMetas[MetasUnidadesAsesores], 0) 
			
			 RETURN
			
			SWITCH(
			    TRUE(),
			
			    -- Cuando estoy en el nivel Cliente
			    ISINSCOPE(vwPagos[NombreDeudor]), BLANK(),
			
			    -- Cuando estoy en el nivel Asesor
			    ISINSCOPE(vwPagos[Asesor]), DIVIDE([MontosAplicados], _MetaAsesor, 0),
			  
			    -- Cuando estoy en el nivel Unidades
			    ISINSCOPE(vwCasosGestiones[Sucursal_id]), DIVIDE([MontosAplicados], _MetaUnidad, 0),
			
			      -- Totales
			     _TotalGeneral 
			)   
			
			// Var _Efectividad = 
			//          DIVIDE([MontosAplicados], vwMetas[MetasUnidadesAsesores], 0)
			
			//RETURN
			//IF(
			//    ISINSCOPE(vwPagos[NombreDeudor]),
			//    BLANK(),
			//    _Efectividad
			//)
			
			
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Recuperación
		lineageTag: cd6671a9-b6b0-451e-8acd-ee93c5eaccef

