	/// Narrativa automática para tooltip del gráfico Recuperación por Unidad Año vs Año
	measure Narrativa_Tooltip_Recuperacion = ```
			
			
			VAR _Unidad    = SELECTEDVALUE(vwRotacionPagosPorUnidades_Deudores[Sucursal_id], "Todas las unidades")
			VAR _Supervisor = vwRotacionPagosPorUnidades_Deudores[NombreSupervisor]
			VAR _YearAct   = YEAR(TODAY())
			VAR _YearAnt   = _YearAct - 1
			VAR _MonthAct  = vwPagos[NombreMes]
			
			VAR _RecAct    = CALCULATE(
			                    SUM(vwRotacionPagosPorUnidades_Deudores[MontoPagoRDUS]),
			                    vwRotacionPagosPorUnidades_Deudores[Año] = _YearAct
			                 )
			VAR _RecAnt    = CALCULATE(
			                    SUM(vwRotacionPagosPorUnidades_Deudores[MontoPagoRDUS]),
			                    vwRotacionPagosPorUnidades_Deudores[Año] = _YearAnt
			                 )
			
			VAR _Meta      = CALCULATE(
			                    (SUM(vwMetas[MontoMetas])) * MONTH(TODAY()),
			                    TREATAS(VALUES(vwRotacionPagosPorUnidades_Deudores[Sucursal_id]), vwMetas[Unidad])
			                 )
			
			VAR _Var       = IF(NOT ISBLANK(_RecAnt) && _RecAnt <> 0, DIVIDE(_RecAct - _RecAnt, _RecAnt), BLANK())
			VAR _VarPct    = IF(NOT ISBLANK(_Var), FORMAT(ABS(_Var), "#,0.0%"), "N/D")
			VAR _VarDir    = IF(_Var > 0, "▲ subió", IF(_Var < 0, "▼ bajó", "→ igual"))
			
			VAR _PctMeta   = IF(NOT ISBLANK(_Meta) && _Meta <> 0, DIVIDE(_RecAct, _Meta), BLANK())
			VAR _PctMetaTxt= IF(NOT ISBLANK(_PctMeta), FORMAT(_PctMeta, "#,0.0%"), "Sin meta")
			VAR _EstadoMeta= IF(_PctMeta >= 1, "✅ Meta cumplida", IF(_PctMeta >= 0.8, "🔶 Cerca de la meta", "🔴 Por debajo de la meta")) & " al mes de " & _MonthAct & " del " & YEAR(TODAY())
			
			VAR _RecActTxt = IF(NOT ISBLANK(_RecAct), FORMAT(_RecAct, "$#,0"), "Sin datos")
			VAR _RecAntTxt = IF(NOT ISBLANK(_RecAnt), FORMAT(_RecAnt, "$#,0"), "Sin datos")
			VAR _MetaTxt   = IF(NOT ISBLANK(_Meta) && _Meta <> 0, FORMAT(_Meta, "$#,0"), "Sin meta")
			
			RETURN
			  "📍 Unidad: " & _Unidad & " " & _Supervisor 
			& UNICHAR(10)
			& "━━━━━━━━━━━━━━━━━━━━━━━"
			& UNICHAR(10)
			& "📅 " & _YearAct & ":  " & _RecActTxt
			& UNICHAR(10)
			& "📅 " & _YearAnt & ":  " & _RecAntTxt
			& UNICHAR(10)
			& "━━━━━━━━━━━━━━━━━━━━━━━"
			& UNICHAR(10)
			& "📈 Variación: " & _VarDir & " " & _VarPct
			& UNICHAR(10)
			
			//& "🎯 Meta:  " & _MetaTxt
			//& UNICHAR(10)
			//& "📊 Avance meta:  " & _PctMetaTxt
			//& UNICHAR(10)
			
			//& _EstadoMeta
			
			```
		displayFolder: Títulos dinámicos
		lineageTag: 8545d9ac-3c01-4384-ad09-230bf264cdd9
		dataCategory: Unconstrained

	measure NombreMes = ```
			
			SWITCH(
			    MONTH(TODAY()),
			    1, "Enero",
			    2, "Febrero",
			    3, "Marzo",
			    4, "Abril",
			    5, "Mayo",
			    6, "Junio",
			    7, "Julio",
			    8, "Agosto",
			    9, "Septiembre",
			    10, "Octubre",
			    11, "Noviembre",
			    12, "Diciembre",
			    BLANK()
			)
			
			```
		displayFolder: Títulos dinámicos
		lineageTag: f6ab13c6-57a1-41cc-ad90-77cf6eb8a66c

