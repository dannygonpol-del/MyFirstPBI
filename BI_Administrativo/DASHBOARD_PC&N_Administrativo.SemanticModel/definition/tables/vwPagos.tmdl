table vwPagos
	lineageTag: 6e6b0721-eef9-4be8-a4c7-e4405814c995

	/// Porcentaje de la meta que falta por cumplir (en blanco si ya se superó)
	measure %PorCumplir = ```
			
			
			    VAR TotalMeta       = MAX(vwPagos[MontoMeta])
			    VAR TotalRecuperado = SUM(vwPagos[MontoPagado])
			    VAR MetaFaltante    = TotalMeta - TotalRecuperado
			
			    RETURN    
			            IF(
			                    MetaFaltante <= 0.00,
			                    BLANK(), 
			                //  DIVIDE(MetaFaltante, TotalMeta)
			
			                DIVIDE(TotalRecuperado, TotalMeta) //* 100
			                
			                ) 
			```
		formatString: 0.00%
		displayFolder: Recuperación
		lineageTag: bb3c45e8-153d-4ff6-83a3-2af2db4d599a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Monto faltante para alcanzar la meta (por oficial o total según contexto)
	measure PorCumplir = ```
			VAR TotalMeta       =  CALCULATE(SUM(vwMetas[MontoMetas]), TREATAS(values(vwPagos[Sucursal_id]),vwMetas[Unidad]))
			VAR TotalRecuperado = SUM(vwPagos[MontoPagado])
			VAR Resultado       = abs(TotalMeta - TotalRecuperado)
			
			RETURN
			IF(
			    ISINSCOPE(vwPagos[codigo]),
			    -- Cálculo por fila
			    ABS(
			        MAX(vwPagos[MontoMeta]) - 
			        SUM(vwPagos[MontoPagado])
			    )
			    ,
			    -- Cálculo SOLO para el total
			    Resultado
			)
			```
		formatString: $#,0.00;($#,0.00);$#,0.00
		displayFolder: Recuperación
		lineageTag: 96c2b552-974c-4d07-9f31-0b815e63d922

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Monto que excede la meta (negativo = meta superada)
	measure Cumplido = ```
			VAR TotalMeta       = MAX(vwPagos[MontoMeta])
			VAR TotalRecuperado = SUM(vwPagos[MontoPagado])
			VAR MetaFaltante    = TotalMeta - TotalRecuperado
			
			RETURN     IF(
			        MetaFaltante < 0.00, MetaFaltante,
			        BLANK()        
			    ) 
			```
		formatString: $#,0.00;($#,0.00);$#,0.00
		displayFolder: Recuperación
		lineageTag: 612772c3-ce06-44c4-b2a3-a2b73399d715

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Color semáforo para el % pendiente: azul si meta cumplida, rojo si falta
	measure Color%PorCumplir =
			
			--VAR Pct = [PorCumplir]
			VAR TotalMeta       =  CALCULATE(SUM(vwMetas[MontoMetas]), TREATAS(values(vwPagos[Sucursal_id]),vwMetas[Unidad]))
			VAR TotalRecuperado = SUM(vwPagos[MontoPagado])
			VAR Resultado       = (TotalMeta - TotalRecuperado)
			
			RETURN
			    SWITCH(
			        TRUE(),
			       -- ISBLANK(Resultado), "#FF4C4C" -- Valores en negativo
			        Resultado < 0.00, "#000000" -- Valores en negativo COLOR NEGRO
			
			      , Resultado > 0.00, "#990000"  --COLOR ROJO
			
			        --, "#0000FF"
			    )
		displayFolder: Recuperación
		lineageTag: f4f4b675-e846-41d6-8336-a98e1abb299c

	/// Meta del oficial o total de la sucursal según nivel de contexto
	measure MontoMeta$ = ```
			
			
			    IF(ISINSCOPE(vwPagos[codigo]),max(vwPagos[MontoMeta]), 
			        CALCULATE(SUM(vwMetas[MontoMetas]), 
			            TREATAS(values(vwPagos[Sucursal_id]),vwMetas[Unidad])))
			
			```
		formatString: $#,0.00;($#,0.00);$#,0.00
		displayFolder: Recuperación
		lineageTag: 97207d14-34a3-444c-97ae-eb5f6dadacfa

		annotation PBI_FormatHint = {"currencyCulture":"es-DO"}

