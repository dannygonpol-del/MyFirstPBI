			   //EOMONTH(TODAY(), 0) --TODAY()
			   
			   -- DATE(2026,5,31)
			     --MAX(Calendario[Date])
			      
			
			RETURN
			
			CALCULATE(
			    //sum(vwCasos[MontoPrometido]),
			
			    sum(vwPagos[MontoPagadoRDUS]),
			
			   TREATAS(
			        VALUES(vwCasos[CodigoCliente]),
			       vwPagos[CodigoCliente]
			    )
			    
			  )
			```
		formatString: $#,0.00;($#,0.00);$#,0.00
		displayFolder: Recuperación
