	/// Porcentaje de recuperación sobre la meta asignada
	measure %Recuperacion = DIVIDE([MontoRecuperado], [MontoMeta$], 0)
		formatString: 0.00%
		displayFolder: Recuperación
		lineageTag: a5eda110-d430-4e4e-b454-bc0aa98d5aa4

	/// Porcentaje del monto en revisión respecto al total recuperado; en blanco si revisión >= total
	measure %PorRevision = ```
			
			VAR   TotalRecuperado     = SUM(vwPagos[MontoPagado])
			VAR TotalRevision  = SUM(vwPagos[MontoPagadoRevision])
			VAR RecuperacionTotalFaltante    = TotalRecuperado - TotalRevision
			
			RETURN    
			 IF(
			        RecuperacionTotalFaltante <= 0.00,
			        BLANK(), 
			        DIVIDE(TotalRevision, TotalRecuperado)
			    ) 
			//  RecuperacionTotalFaltante
			```
		displayFolder: Recuperación
		lineageTag: 9e72fd0f-fb0d-47eb-ad94-f07ff237d836

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Suma acumulada del monto en revisión desde enero hasta el mes seleccionado en el año en curso
	measure MontoRevisionMesesAnteriores =
			
			VAR FechaSeleccionada = MAX('Calendario'[Date])
			
			RETURN
			CALCULATE(
			    SUM(vwPagos[MontoPagadoRevision]),
			    FILTER(
			        ALL('Calendario'),
			        YEAR('Calendario'[Date]) = YEAR(FechaSeleccionada) &&
			        MONTH('Calendario'[Date]) <= MONTH(FechaSeleccionada)
			    )
			)
		displayFolder: Recuperación
		lineageTag: 2504449a-2a06-4673-8222-d7e16a1ebf27

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Monto faltante para la meta: por fila usa MontoMeta del asesor; total usa la meta de la sucursal
	measure PorCumplir01 = ```
			VAR TotalMeta       =  CALCULATE(SUM(vwMetas[MontoMetas]), TREATAS(values(vwPagos[Sucursal_id]),vwMetas[Unidad]))
			VAR TotalRecuperado = SUM(vwPagos[MontoPagado])
			VAR Resultado       = (TotalMeta - TotalRecuperado)
			
			RETURN
			IF(
			    ISINSCOPE(vwPagos[codigo]),
			    -- Cálculo por fila
			    ABS(
			        MAX(vwPagos[MontoMeta]) - 
			        SUM(vwPagos[MontoPagado])
			    )
			    ,
			    -- Cálculo SOLO para el total
			    Resultado
			)
			```
		displayFolder: Recuperación
		lineageTag: bfedcdba-24a7-4ad8-b0f6-8cf99a4b2ffc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

