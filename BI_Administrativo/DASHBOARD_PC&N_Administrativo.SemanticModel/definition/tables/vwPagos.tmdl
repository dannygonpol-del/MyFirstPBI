	/// Suma total de pagos recibidos
	measure MontoRecuperado = ```
			
			
			//sum(vwPagos[MontoPagado])
			
			  VAR FechaInicio = MIN(Calendario[Date])
			   // DATE(YEAR(TODAY()), MONTH(TODAY()), 1)
			  
			  --  DATE(2026,5,1)
			   -- MIN(Calendario[Date])
			
