	column UnidadesF =
			
			SWITCH(
			    TRUE(),
			    vwMetas[Unidad] IN {"CC1","CC2","CC3","CC4"}, MID(vwMetas[Unidad], 1, 2) & "-" & RIGHT(vwMetas[Unidad]),
			    vwMetas[Unidad] IN {"ADMINISTRATIVOS"}, "Administrativos",
			    vwMetas[Unidad] IN {"GA"}, "Area Legal",
			    vwMetas[Unidad] IN {"SWAT"}, "SWAT",
			    vwMetas[Unidad]   -- valor por defecto
			)
		displayFolder: Metas
		lineageTag: 4227b2f2-2d34-4ac5-aef7-5918c3c17bf0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition vwMetas = m
		mode: dual
		source =
				let
				    Origen = Sql.Database("192.168.9.104,1433", "SigecobDS"),
				    dbo_vwMetas = Origen{[Schema="dbo",Item="vwMetas"]}[Data]
				in
				    dbo_vwMetas

	annotation PBI_ResultType = Table

