table vwRotacionPagosPorClienetes_Deudores
	lineageTag: f4275f10-b2e2-4c40-b5c2-35c04b665a3a

	measure MontoPagado = ```
			
			
			    sum(vwRotacionPagosPorClienetes_Deudores[MontoPago])
			```
		lineageTag: 60679747-cd8d-494c-9d89-b5cb9f826e14

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure MostrarFila =
			
			
			VAR MesesConPago =
			    CALCULATE(
			        DISTINCTCOUNT(vwRotacionPagosPorClienetes_Deudores[Mes]),
			        FILTER(
			            ALL(vwRotacionPagosPorClienetes_Deudores[Mes]),
			            CALCULATE(SUM(vwRotacionPagosPorClienetes_Deudores[MontoPago])) > 0
			        )
			    )
			RETURN
			IF(MesesConPago < 3, 1, 0)
		formatString: 0
		lineageTag: a822dc6b-5ae6-4659-9723-ea4ba611a7a9

	measure ColorEstado = ```
			
			IF(
			    SELECTEDVALUE(vwRotacionPagosPorClienetes_Deudores[EstadoAsesor]) = FALSE(),
			    //"#00B050",    -- Verde
			    "#FF0000"     -- Rojo
			)
			
			```
		lineageTag: 13cb3025-781c-4be5-a4f6-10f286b1aa85

	measure PagosProcesados = ```
			
			
			     SUMX(
			    vwRotacionPagosPorClienetes_Deudores,
			    SWITCH(
			        vwRotacionPagosPorClienetes_Deudores[divisa],
			        "RD", vwRotacionPagosPorClienetes_Deudores[MontoPago],
			        "US", vwRotacionPagosPorClienetes_Deudores[MontoPago],
			        0
			    )
			)
			
			
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: bd307b61-9796-44ca-bff9-52457cecdd30

		annotation PBI_FormatHint = {"currencyCulture":"es-DO"}

