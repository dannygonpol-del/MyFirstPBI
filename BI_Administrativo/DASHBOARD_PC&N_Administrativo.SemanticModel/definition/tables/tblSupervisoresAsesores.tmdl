table tblSupervisoresAsesores
	lineageTag: 3fcbceca-2e2d-4e2b-ac53-6bcf174ace2c

	measure AsesoresActivosPorUnidad = ```
			
			
			    CALCULATE(
			                COUNT(tblSupervisoresAsesores[Codigo]),
			                FILTER(tblSupervisoresAsesores,
			                        tblSupervisoresAsesores[TipoAsesor] IN {"A", "L"}
			                        && tblSupervisoresAsesores[EstatusPuesto] = "A"
			                      
			
			                     )
			                     
			  )
			  
			```
		formatString: 0
		lineageTag: d3404ece-6c41-44ff-a7b9-a0b7dc146a15

	measure AsesoresFaltantesPorUNidad = ```
			
			
			 CALCULATE(
			
			            tblSupervisoresAsesores[CapacidadAsesoresPorUnidad] - tblSupervisoresAsesores[AsesoresActivosPorUnidad]
			
			 )
			 
			```
		lineageTag: 8722b360-6742-4739-9335-e5de436f1a06

	measure CapacidadAsesoresPorUnidad = ```
			
			
			    CALCULATE(
			                COUNT(tblSupervisoresAsesores[Codigo]),
			                FILTER(tblSupervisoresAsesores,
			                        tblSupervisoresAsesores[TipoAsesor] IN {"A", "L"}
			
			                     )
			                     
			  )
			```
		formatString: 0
		lineageTag: 8ccae821-d520-4e4c-80bc-a83b6d8e9fa0

	measure TeamLeadersActivosPorUnidad = ```
			
			
			CALCULATE(
			    COUNT(tblSupervisoresAsesores[Codigo]),
			            FILTER( 
			                tblSupervisoresAsesores,
			                tblSupervisoresAsesores[TipoAsesor] = "L"
			                && tblSupervisoresAsesores[EstatusPuesto] = "A"
			    
			        )
			    )
			```
		formatString: 0
		lineageTag: d38f4f86-8cb6-4a6a-a73d-7abc91f3d006

