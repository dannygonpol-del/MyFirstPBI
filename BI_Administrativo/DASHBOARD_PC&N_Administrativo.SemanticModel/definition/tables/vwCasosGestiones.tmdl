table vwCasosGestiones
	lineageTag: bc520186-5b52-444d-ad8c-51d0cda4ec2b

	/// Cantidad distinta de gestiones del mes vigente para los asesores del contexto de vwCasosGestiones
	measure Cant_Gestiones = ```
			
			
			 CALCULATE(
			    DISTINCTCOUNT(vwGestiones[IdGestion]),
			    FILTER(       
			        vwGestiones,
			        vwGestiones[Oficiales]
			            IN  VALUES(vwCasosGestiones[Codigo])        
			            
			    )
			
			)
			
			
			```
		formatString: 0
		displayFolder: Gestiones
		lineageTag: 2bb24d43-4880-451f-ac25-ae226a34b3e3

	/// Porcentaje de rotación de cartera: gestiones dividido entre casos, escalado al 50%
	measure '% Rotacion_Cartera' = ```
			
			
			   // DIVIDE(vwCasosGestiones[Cant_Casos$], vwCasosGestiones[Cant_Gestiones],BLANK())
			
			   DIVIDE(vwCasosGestiones[Cant_Gestiones], vwCasosGestiones[Cant_Casos$_bk],BLANK()) / 2
			```
		displayFolder: Cartera
		lineageTag: d412b6b9-80f9-4cc3-8e30-41fc7db5600e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Título dinámico que muestra la unidad seleccionada para encabezados de reporte
	measure Titulo = ```
			
			
			  VAR FechaInicio = DATE(YEAR(TODAY()), MONTH(TODAY()), 1)
			
			  VAR FechaDia = TODAY()
			
			  VAR Titulo =  "Datos Generales de la Unidad " //"Datos Al : "
			
			
			
			  RETURN
			
			  Titulo & "    " & SELECTEDVALUE(vwCasosGestiones[Sucursal_id], "")
			
			  //Titulo & FechaDia & "    " & SELECTEDVALUE(vwCasosGestiones[Sucursal_id], "")
			```
		displayFolder: Títulos dinámicos
		lineageTag: f316d6af-c5be-4455-abaf-1fd22c086350

	/// Cantidad de filas de vwCasosGestiones ignorando el filtro del calendario
	measure Cant_Casos$_bk = ```
			
			
			IF( 
			    
			    SELECTEDVALUE(vwCasosGestiones[Sucursal_id]) <> "LEGAL",
			            CALCULATE(
			                DISTINCTCOUNT(vwCasosGestiones[CantCasos]), 
			                                    vwCasosGestiones[EstadoCaso] <> "PROC-LEGAL",
			                                    vwCasosGestiones[INACTIVO] = FALSE(),
			
			                                REMOVEFILTERS(Calendario)
			            ),
			            CALCULATE(
			                DISTINCTCOUNT(vwCasosGestiones[CantCasos]), 
			                                    vwCasosGestiones[EstadoCaso] = "PROC-LEGAL",
			                                    vwCasosGestiones[INACTIVO] = FALSE(),
			
			                                REMOVEFILTERS(Calendario)
			            )
			
			)
			
			```
		formatString: 0
		displayFolder: Cartera
		lineageTag: 09237335-b937-4c23-b5de-852224eb0c4a

	/// Suma de pagos recibidos para los asesores visibles en vwCasosGestiones, filtrado por calendario
	measure Monto_recuperacion = ```
			
			
			
			CALCULATE(
			    SUM(vwPagos[MontoPagadoRDUS]),
			    FILTER(
			        vwPagos,
			         vwPagos[Codigo] IN VALUES(AsesoresCasosGestionesPagos[Codigo]) 
			        
			  
			    )
			)
			
			
			
			```
		formatString: 0
		displayFolder: Recuperación
		lineageTag: e0089bb7-795d-4aba-976f-4e34d026b7dd

	/// Cantidad distinta de promesas de los asesores en contexto de vwCasosGestiones
	measure Cant_Promesas = ```
			
			
			 
			VAR _CodigoActual =
			    VALUES(AsesoresCasosGestionesPagos[Codigo])
			
			VAR _FechaInicial =
			    MIN(Calendario[Date])    
			
			VAR _FechaFinal =
			    MAX(Calendario[Date])
			
			RETURN
			
			CALCULATE(
			    DISTINCTCOUNT(vwCasos[IdPromesa]),
			    REMOVEFILTERS(vwCasos),
			    TREATAS(
			        _CodigoActual,
			        vwCasos[Codigo]
			    ),
			    REMOVEFILTERS(Calendario),
			
			    vwCasos[FechaPromesa] >= _FechaInicial && vwCasos[FechaPromesa] <= _FechaFinal
			
			  //   , (vwCasos[FechaPromesa] = _FechaFinal)
			)
			
			```
		formatString: 0
		displayFolder: Promesas
		lineageTag: 5b4d181a-3573-4e5c-a38f-0bdeca6aa1d2

	/// Suma del monto prometido para los asesores en contexto de vwCasosGestiones
	measure Monto_Promesas = ```
			
			
			 
			 
			  VAR FechaInicio =
			    DATE(YEAR(TODAY()), MONTH(TODAY()), 1)
			  
			   VAR FechaFin = EOMONTH(TODAY(), 0) --TODAY()  
			
			   VAR _CodigoActual =
			    VALUES(AsesoresCasosGestionesPagos[Codigo])
			
			   VAR _FechaInicial =
			    MIN(Calendario[Date])    
			
			   VAR _FechaFinal =
			    MAX(Calendario[Date])
			   
			
			RETURN
			
			CALCULATE(
			    SUM(vwCasos[MontoPrometido]),
			    REMOVEFILTERS(vwCasos),
			    TREATAS(
			        _CodigoActual,
			        vwCasos[Codigo]
			    ),
			    REMOVEFILTERS(Calendario),
			
			    vwCasos[FechaPromesa] >= _FechaInicial && vwCasos[FechaPromesa] <= _FechaFinal
			)
			
			
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Promesas
		lineageTag: 8a0d4e2c-14aa-49fc-b671-dbb634cf7d05

		annotation PBI_FormatHint = {"currencyCulture":"es-DO"}

	/// Porcentaje del monto recuperado sobre el monto prometido para los asesores en contexto
