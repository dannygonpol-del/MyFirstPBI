	/// Meta de recuperación del asesor seleccionado, leída de vwMetasAsesores por código
	measure Monto_Metas1$ = ```
			
			
			
			VAR _Codigo =
			      CALCULATE(
			      SELECTEDVALUE(vwCasosGestiones[Codigo]),
			        REMOVEFILTERS(Calendario)
			    )
			    
			RETURN
			
			IF(
			    NOT ISBLANK(_Codigo),
			    CALCULATE(
			        MAX(vwMetasAsesores[MontoMetas]),
			
			       TREATAS(
			            {_Codigo},
			            vwMetasAsesores[Codigo]
			        ),
			
			       REMOVEFILTERS(Calendario)
			    ),
			
			       IF(ISINSCOPE(AsesoresCasosGestionesPagos[Codigo]),max(vwPagos[MontoMeta]), 
			        CALCULATE(SUM(vwMetas[MontoMetas]), TREATAS(values(vwCasosGestiones[Sucursal_id]),vwMetas[Unidad]))
			        
			        )
			        
			  //      ,
			  //BLANK()
			
			)
			
			
			
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Metas
		lineageTag: fd41efbd-f89a-4bfe-95ad-542ff3a3f6d2

		annotation PBI_FormatHint = {"currencyCulture":"es-DO"}

	/// Diferencia entre la meta del asesor y el monto recuperado en el contexto actual
	measure Faltante_Meta_Recuperado = ```
			
			VAR _Codigo =
			    SELECTEDVALUE(vwCasosGestiones[Codigo])
			
			RETURN
			
			IF(
			    NOT ISBLANK(_Codigo),
			
			    [Monto_Metas1$] - [Monto_recuperacion]
			    ,
			
			     vwCasosGestiones[Monto_Metas1$] -  vwCasosGestiones[Monto_recuperacion]
			
			
			   // BLANK()
			   
			)
			
			
			```
		displayFolder: Metas
		lineageTag: 8c0fa0e3-04ea-49da-b0fb-310f135084bb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

