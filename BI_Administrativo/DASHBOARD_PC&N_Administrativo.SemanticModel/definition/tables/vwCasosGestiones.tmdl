	/// Tasa de cambio USD a RD$ usada para consolidar la cartera en moneda local. Actualizar este valor mensualmente.
	measure TasaCambioUSD_RD = ```
			
			    MAX(vwPagos[Tasa])
			```
		formatString: "RD$"#,0.00
		displayFolder: Moneda
		lineageTag: a309289c-aed3-434c-8f7b-d9ccb1c99832

	/// Cartera total consolidada en pesos dominicanos: suma MontoRD más MontoUS convertido a RD$ usando la tasa de cambio
	measure MontoCartera_TotalRD =
			
			VAR TasaCambio = [TasaCambioUSD_RD]
			RETURN
			CALCULATE(
			    SUM(vwCasosGestiones[MontoRD]) + SUM(vwCasosGestiones[MontoUS]) * TasaCambio,
			    REMOVEFILTERS(Calendario)
			)
		formatString: "RD$"#,0.00
		displayFolder: Cartera
		lineageTag: ab3d0efc-8932-47d9-a972-2b4b77342a33

	/// Cartera total consolidada en dólares: suma MontoUS más MontoRD convertido a USD dividiendo por la tasa de cambio
	measure MontoCartera_TotalUS =
			
			VAR TasaCambio = [TasaCambioUSD_RD]
			RETURN
			CALCULATE(
			    SUM(vwCasosGestiones[MontoUS]) + DIVIDE(SUM(vwCasosGestiones[MontoRD]), TasaCambio),
			    REMOVEFILTERS(Calendario)
			)
		formatString: "US$"#,0.00
		displayFolder: Cartera
		lineageTag: 7faa0d29-1a82-426c-9aa8-9e11331b6207

	/// Porcentaje que representa la cartera en dólares sobre el total consolidado en RD$
	measure %CarteraEnUSD =
			
			VAR TasaCambio = [TasaCambioUSD_RD]
			VAR MontoUS_enRD = CALCULATE(SUM(vwCasosGestiones[MontoUS]), REMOVEFILTERS(Calendario)) * TasaCambio
			VAR TotalRD = [MontoCartera_TotalRD]
			RETURN
			DIVIDE(MontoUS_enRD, TotalRD)
		formatString: 0.0 %
		displayFolder: Cartera
		lineageTag: 4ced8c86-c8ee-47e0-bdfc-ebf23501ee03

