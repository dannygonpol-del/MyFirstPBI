	measure Titulo_recuperacion_anual = ```
			
			
			  VAR _Titulo = "Recuperación por Unidad Año "  
			
			  VAR _AnoMin =  MIN(vwRotacionPagosPorUnidades_Deudores[Año]) //  year(today()) - 1
			
			  VAR _AnoMax =  MAX(vwRotacionPagosPorUnidades_Deudores[Año]) //year(today())
			
			
			  RETURN
			
			  IF(
			    HASONEVALUE(vwRotacionPagosPorUnidades_Deudores[Año]),
			    _Titulo & " " & _AnoMin,
			    _Titulo & " " & _AnoMin & " Vrs. " & _AnoMax
			)
			
